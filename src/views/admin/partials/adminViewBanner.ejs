<% if (typeof adminViewContext !== 'undefined' && adminViewContext) { %>
<!-- ==========================================
     SUPER ADMIN VIEW MODE PERSISTENT BANNER
     ========================================== -->
<div class="admin-view-banner" id="adminViewBanner" role="region" aria-label="Administrator View Mode">
    <div style="display: flex; align-items: center; gap: 14px;">
        <span class="admin-view-badge">
            <span>🛡️</span>
            <span>ADMIN VIEW MODE</span>
        </span>
        <div class="admin-view-info">
            <span>Authenticated: <strong>Super Admin (<%= user.username %>)</strong></span>
            <span>&bull;</span>
            <span>Simulating View: <strong><%= adminViewContext.mode === 'PATIENT' ? 'Patient Portal' : 'Doctor Portal' %> — <%= adminViewContext.targetName %> (<%= adminViewContext.targetId %>)</strong></span>
        </div>
    </div>
    <div>
        <a href="/admin/overview" class="admin-view-exit-btn" id="exitAdminViewBtn" title="Return to Super Admin Portal">
            <span>&larr;</span>
            <span>Return to Admin</span>
        </a>
    </div>
</div>

<script src="/js/toast.js"></script>
<script>
(function() {
    function setupRestrictedNav() {
        const navLinks = document.querySelectorAll(".sidebar nav a, aside nav a");
        navLinks.forEach(link => {
            if (!link.classList.contains("active")) {
                link.addEventListener("click", function(e) {
                    e.preventDefault();
                    const text = (this.innerText || this.textContent || "Section").trim();
                    if (window.showToast) {
                        window.showToast(`Private Section: "${text}" is restricted in Quick-Switch View Mode. Click 'Return to Admin' to manage accounts.`, "warning", 4500);
                    } else {
                        alert(`Private Section: "${text}" is restricted in Quick-Switch View Mode. Click 'Return to Admin' to manage accounts.`);
                    }
                });
                link.style.opacity = "0.6";
                link.style.cursor = "not-allowed";
                link.title = "Restricted in Admin View Mode";
            }
        });
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupRestrictedNav);
    } else {
        setupRestrictedNav();
    }
})();
</script>
<% } %>
