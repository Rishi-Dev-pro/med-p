<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthTrack — Super Admin Activity</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
    <%- include("partials/sidebar", { activePage, user }) %>

    <div class="admin-main">
        <%- include("partials/topbar", { 
            pageTitle: "System Activity & Audit Trail", 
            pageSubtitle: "Immutable system event logs, administrative actions, and security triggers",
            user 
        }) %>

        <main class="admin-content-body">
            <!-- Phase 13 Foundation Notice -->
            <div class="foundation-banner">
                <span class="foundation-badge">PHASE 4 FOUNDATION</span>
                <p>
                    <strong>Administrative Audit Trail Foundation:</strong> Read-only inspection of system events. Complete chronological audit streaming, multi-parameter filtering, and security compliance analytics are scheduled for <strong>Phase 13 (Centralized System Activity & Audit Trail)</strong>.
                </p>
            </div>

            <section class="section-panel">
                <div class="panel-header">
                    <h2 class="panel-title">System Event Log</h2>
                    <span class="panel-badge"><%= activities ? activities.length : 0 %> Events Recorded</span>
                </div>

                <% if (!activities || activities.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-state-icon">📋</div>
                        <h3>No activity records logged yet</h3>
                        <p>Immutable system audit records will be generated automatically when administrative and clinical events occur on the platform.</p>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Timestamp</th>
                                    <th>Action</th>
                                    <th>Actor</th>
                                    <th>Target Entity</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% activities.forEach(act => { %>
                                    <tr>
                                        <td><%= act.timestamp ? new Date(act.timestamp).toLocaleString() : "—" %></td>
                                        <td>
                                            <span class="status-pill active-pill"><%= act.action %></span>
                                        </td>
                                        <td>
                                            <strong><%= act.actorRole || "SYSTEM" %></strong>
                                            <% if (act.actorId) { %>
                                                <span class="id-cell">(<%= act.actorId %>)</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span><%= act.targetType || "ENTITY" %></span>
                                            <% if (act.targetId) { %>
                                                <span class="id-cell"><%= act.targetId %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (act.details && Object.keys(act.details).length > 0) { %>
                                                <pre style="font-size: 11px; margin: 0; color: var(--muted);"><%= JSON.stringify(act.details) %></pre>
                                            <% } else { %>
                                                <span class="metric-sub">—</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>
        </main>
    </div>
</div>
</body>
</html>
