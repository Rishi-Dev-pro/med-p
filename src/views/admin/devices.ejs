<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthTrack — Super Admin Devices</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
    <%- include("partials/sidebar", { activePage, user }) %>

    <div class="admin-main">
        <%- include("partials/topbar", { 
            pageTitle: "Device Inventory", 
            pageSubtitle: "Hardware sensor telemetry devices, binding status, lifecycle state, and hardware reset engine",
            user 
        }) %>

        <main class="admin-content-body">
            <!-- Phase 5 Active Device Lifecycle Banner -->
            <div class="foundation-banner" style="border-left: 3px solid var(--burnt-orange);">
                <span class="foundation-badge" style="background: var(--burnt-orange);">PHASE 5 ENGINE</span>
                <p>
                    <strong>Hardware Device Lifecycle Engine:</strong> Full device lifecycle management active. Super Admins can provision devices, toggle hardware availability (Activate/Deactivate), trigger atomic unlinking and resets with historical telemetry preserved, and safely decommission unassigned units.
                </p>
            </div>

            <section class="section-panel">
                <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <h2 class="panel-title">Hardware Telemetry Units</h2>
                        <span class="panel-badge" id="deviceCountBadge"><%= devices ? devices.length : 0 %> Devices</span>
                    </div>
                    <button type="button" class="btn-primary-action" id="openCreateDeviceBtn">
                        <span>+</span> Provision Device
                    </button>
                </div>

                <div id="operationAlert" style="display: none; margin: 16px 0; padding: 12px 16px; border-radius: 8px; font-size: 13px;"></div>

                <% if (!devices || devices.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-state-icon">📟</div>
                        <h3>No devices found</h3>
                        <p>No IoT devices have been registered in the hardware database yet. Click "Provision Device" to add your first hardware unit.</p>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Device ID</th>
                                    <th>Type</th>
                                    <th>Lifecycle Status</th>
                                    <th>Telemetry Health</th>
                                    <th>Binding Status</th>
                                    <th>Assigned Patient</th>
                                    <th>Reset Count</th>
                                    <th>Last Seen</th>
                                    <th>Tx Frequency</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% devices.forEach(d => { 
                                    const isActive = (d.status === 'ACTIVE' || d.status === 'active');
                                    const isAssigned = !!d.patientId;
                                    const health = d.health || 'OFFLINE';
                                %>
                                    <tr id="row-<%= d.deviceId %>" 
                                        data-device-id="<%= d.deviceId %>"
                                        data-status="<%= (d.status || 'ACTIVE').toUpperCase() %>"
                                        data-last-seen="<%= d.lastSeen ? new Date(d.lastSeen).toISOString() : '' %>">
                                        <td class="id-cell">
                                            <strong><%= d.deviceId %></strong>
                                        </td>
                                        <td><%= d.type || 'VITAL_TELEMETRY' %></td>
                                        <td>
                                            <span class="status-pill <%= isActive ? 'active-pill' : 'inactive-pill' %>" id="status-<%= d.deviceId %>">
                                                <%= (d.status || 'ACTIVE').toUpperCase() %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="telemetry-health-badge health-badge-<%= health.toLowerCase() %>" 
                                                  id="health-badge-<%= d.deviceId %>" 
                                                  role="status" 
                                                  aria-label="Device health: <%= health %>">
                                                <span class="health-pulse-dot"></span>
                                                <span class="health-text" id="health-text-<%= d.deviceId %>"><%= health %></span>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="status-pill <%= isAssigned ? 'assigned-pill' : 'unassigned-pill' %>" id="binding-<%= d.deviceId %>">
                                                <%= isAssigned ? 'ASSIGNED' : 'UNASSIGNED' %>
                                            </span>
                                        </td>
                                        <td id="patient-<%= d.deviceId %>">
                                            <% if (d.patientId) { %>
                                                <span class="id-cell"><%= d.patientId %></span>
                                                <% if (d.patientName) { %>
                                                    <span class="metric-sub">(<%= d.patientName %>)</span>
                                                <% } %>
                                            <% } else { %>
                                                <span class="metric-sub" style="color: var(--muted); font-style: italic;">None (Unassigned)</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <strong id="resets-<%= d.deviceId %>"><%= d.resetCount %></strong>
                                            <span class="metric-sub">resets</span>
                                        </td>
                                        <td>
                                            <div id="last-seen-container-<%= d.deviceId %>">
                                                <span id="last-seen-text-<%= d.deviceId %>" style="font-weight: 600;"><%= d.lastSeenFormatted || 'Never' %></span>
                                                <div class="metric-sub" id="last-seen-iso-<%= d.deviceId %>">
                                                    <%= d.lastSeen ? new Date(d.lastSeen).toLocaleTimeString() : 'Never' %>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span id="freq-<%= d.deviceId %>" class="metric-sub" style="font-weight: 600; color: var(--text);">
                                                <%= d.observedFrequency || 'Insufficient data' %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="action-btn-group">
                                                <% if (isActive) { %>
                                                    <button type="button" 
                                                            class="btn-action btn-deactivate" 
                                                            title="Deactivate device"
                                                            onclick="toggleDeviceStatus('<%= d.deviceId %>', false)">
                                                        Deactivate
                                                    </button>
                                                <% } else { %>
                                                    <button type="button" 
                                                            class="btn-action btn-activate" 
                                                            title="Activate device"
                                                            onclick="toggleDeviceStatus('<%= d.deviceId %>', true)">
                                                        Activate
                                                    </button>
                                                <% } %>

                                                <button type="button" 
                                                        class="btn-action btn-reset" 
                                                        title="<%= isAssigned ? 'Unbind patient and reset hardware' : 'Reset hardware counter' %>"
                                                        onclick="openResetModal('<%= d.deviceId %>', '<%= d.patientId || '' %>', '<%= d.patientName || '' %>')">
                                                    Reset
                                                </button>

                                                <button type="button" 
                                                        class="btn-action btn-delete" 
                                                        title="<%= isAssigned ? 'Cannot delete an assigned device. Reset first.' : 'Decommission/Delete device from inventory' %>"
                                                        <%= isAssigned ? 'disabled' : '' %>
                                                        onclick="openDeleteModal('<%= d.deviceId %>')">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>
        </main>
    </div>
</div>

<!-- ========================================================
     MODAL 1: PROVISION / CREATE DEVICE MODAL
     ======================================================== -->
<div class="modal-backdrop" id="createDeviceModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3><span>📟</span> Provision Hardware Device</h3>
            <button type="button" class="modal-close-btn" onclick="closeModal('createDeviceModal')">&times;</button>
        </div>
        <form id="createDeviceForm" onsubmit="handleCreateDevice(event)">
            <div class="modal-body">
                <p style="margin-top: 0; color: var(--muted); font-size: 13px;">
                    Register a new hardware IoT device in the inventory. The unit will start in <strong>ACTIVE</strong> state with 0 resets and no patient assigned.
                </p>
                <div class="modal-field">
                    <label for="newDeviceId">Device ID (Unique Hardware Identifier) *</label>
                    <input type="text" id="newDeviceId" class="modal-input" placeholder="e.g. DEV-003, DEV-104" required autocomplete="off" />
                </div>
                <div class="modal-field">
                    <label for="newDeviceType">Device Telemetry Type</label>
                    <select id="newDeviceType" class="modal-input">
                        <option value="VITAL_TELEMETRY">VITAL_TELEMETRY (Default Standard Vitals)</option>
                        <option value="ECG_MONITOR">ECG_MONITOR (Cardiac Stream)</option>
                        <option value="PULSE_OX">PULSE_OX (Oxygen & Pulse Unit)</option>
                        <option value="GLUCO_METER">GLUCO_METER (Continuous Glucose)</option>
                    </select>
                </div>
                <div id="createDeviceError" style="display: none; color: #EF4444; font-size: 12px; margin-top: 8px;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeModal('createDeviceModal')">Cancel</button>
                <button type="submit" class="btn-primary-action" id="submitCreateBtn">Provision Device</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================================
     MODAL 2: SAFE RESET CONFIRMATION MODAL
     ======================================================== -->
<div class="modal-backdrop" id="resetDeviceModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3><span>⚠️</span> Confirm Hardware Device Reset</h3>
            <button type="button" class="modal-close-btn" onclick="closeModal('resetDeviceModal')">&times;</button>
        </div>
        <div class="modal-body">
            <div class="modal-warning-box">
                <strong>ATOMIC HARDWARE UNLINKING:</strong>
                Resetting will break the current ownership link between device <strong id="resetTargetDeviceId">—</strong> and patient <strong id="resetTargetPatient">—</strong>.
            </div>

            <ul style="padding-left: 20px; font-size: 13px; line-height: 1.7; color: var(--text);">
                <li><strong>Patient Account:</strong> Remains active and completely intact.</li>
                <li><strong>Historical Telemetry:</strong> All historical readings in <code>SensorReading</code> are <strong>strictly preserved</strong>.</li>
                <li><strong>Hardware Invariant:</strong> <code>Device.patientId</code> and <code>Patient.deviceId</code> are atomically set to <code>null</code>.</li>
                <li><strong>Reset Counter:</strong> The device hardware reset count is incremented by 1.</li>
                <li><strong>Reclaimability:</strong> The device returns to <code>ACTIVE + UNASSIGNED</code> inventory ready for future patient binding.</li>
            </ul>

            <div id="resetDeviceError" style="display: none; color: #EF4444; font-size: 12px; margin-top: 8px;"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" onclick="closeModal('resetDeviceModal')">Cancel</button>
            <button type="button" class="btn-warning-confirm" id="confirmResetBtn" onclick="executeDeviceReset()">Confirm Reset</button>
        </div>
    </div>
</div>

<!-- ========================================================
     MODAL 3: SAFE DELETE / DECOMMISSION CONFIRMATION MODAL
     ======================================================== -->
<div class="modal-backdrop" id="deleteDeviceModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3><span>🗑️</span> Decommission Hardware Device</h3>
            <button type="button" class="modal-close-btn" onclick="closeModal('deleteDeviceModal')">&times;</button>
        </div>
        <div class="modal-body">
            <div class="modal-danger-box">
                <strong>PERMANENT INVENTORY REMOVAL:</strong>
                You are about to decommission and delete hardware unit <strong id="deleteTargetDeviceId">—</strong> from active inventory.
            </div>

            <ul style="padding-left: 20px; font-size: 13px; line-height: 1.7; color: var(--text);">
                <li><strong>Safety Check:</strong> Only completely unassigned devices can be decommissioned.</li>
                <li><strong>Data Integrity:</strong> Historical sensor readings previously captured by this unit will <strong>NOT</strong> be deleted.</li>
                <li><strong>Audit Stream:</strong> A <code>DEVICE_DELETED</code> entry will be recorded in the system audit log.</li>
            </ul>

            <div id="deleteDeviceError" style="display: none; color: #EF4444; font-size: 12px; margin-top: 8px;"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" onclick="closeModal('deleteDeviceModal')">Cancel</button>
            <button type="button" class="btn-danger-confirm" id="confirmDeleteBtn" onclick="executeDeviceDelete()">Decommission Device</button>
        </div>
    </div>
</div>

<!-- ========================================================
     CLIENT-SIDE LIFECYCLE SCRIPTS
     ======================================================== -->
<script src="/socket.io/socket.io.js"></script>
<script>
    let activeResetTarget = null;
    let activeDeleteTarget = null;

    function showAlert(message, isSuccess = true) {
        const el = document.getElementById("operationAlert");
        el.style.display = "block";
        el.style.backgroundColor = isSuccess ? "rgba(34, 197, 94, 0.12)" : "rgba(239, 68, 68, 0.12)";
        el.style.color = isSuccess ? "#4ADE80" : "#F87171";
        el.style.border = `1px solid ${isSuccess ? "rgba(34, 197, 94, 0.3)" : "rgba(239, 68, 68, 0.3)"}`;
        el.textContent = message;
        setTimeout(() => {
            el.style.display = "none";
        }, 5000);
    }

    function openModal(id) {
        document.getElementById(id).classList.add("open");
    }

    function closeModal(id) {
        document.getElementById(id).classList.remove("open");
    }

    // Provision Device Modal
    document.getElementById("openCreateDeviceBtn").addEventListener("click", () => {
        document.getElementById("newDeviceId").value = "";
        document.getElementById("createDeviceError").style.display = "none";
        openModal("createDeviceModal");
    });

    async function handleCreateDevice(e) {
        e.preventDefault();
        const deviceId = document.getElementById("newDeviceId").value.trim().toUpperCase();
        const type = document.getElementById("newDeviceType").value;
        const errEl = document.getElementById("createDeviceError");
        const submitBtn = document.getElementById("submitCreateBtn");

        errEl.style.display = "none";
        submitBtn.disabled = true;
        submitBtn.textContent = "Provisioning...";

        try {
            const res = await fetch("/api/admin/devices", {
                method: "POST",
                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                body: JSON.stringify({ deviceId, type })
            });

            const data = await res.json();
            if (!res.ok || !data.success) {
                errEl.textContent = data.message || "Failed to provision device";
                errEl.style.display = "block";
                submitBtn.disabled = false;
                submitBtn.textContent = "Provision Device";
                return;
            }

            closeModal("createDeviceModal");
            showAlert(`Device ${deviceId} provisioned successfully! Reloading...`, true);
            setTimeout(() => window.location.reload(), 800);
        } catch (err) {
            errEl.textContent = "Network error communicating with server";
            errEl.style.display = "block";
            submitBtn.disabled = false;
            submitBtn.textContent = "Provision Device";
        }
    }

    // Toggle Activate / Deactivate
    async function toggleDeviceStatus(deviceId, shouldActivate) {
        const action = shouldActivate ? "activate" : "deactivate";
        try {
            const res = await fetch(`/api/admin/devices/${encodeURIComponent(deviceId)}/${action}`, {
                method: "PATCH",
                headers: { "Accept": "application/json" }
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
                showAlert(data.message || `Failed to ${action} device`, false);
                return;
            }
            showAlert(`Device ${deviceId} ${action}d successfully! Reloading...`, true);
            setTimeout(() => window.location.reload(), 700);
        } catch (err) {
            showAlert(`Network error attempting to ${action} device`, false);
        }
    }

    // Reset Modal
    function openResetModal(deviceId, patientId, patientName) {
        activeResetTarget = deviceId;
        document.getElementById("resetTargetDeviceId").textContent = deviceId;
        document.getElementById("resetTargetPatient").textContent = patientId ? `${patientId} (${patientName || 'Patient'})` : "None (Unassigned)";
        document.getElementById("resetDeviceError").style.display = "none";
        openModal("resetDeviceModal");
    }

    async function executeDeviceReset() {
        if (!activeResetTarget) return;
        const btn = document.getElementById("confirmResetBtn");
        const errEl = document.getElementById("resetDeviceError");
        errEl.style.display = "none";
        btn.disabled = true;
        btn.textContent = "Resetting...";

        try {
            const res = await fetch(`/api/admin/devices/${encodeURIComponent(activeResetTarget)}/reset`, {
                method: "POST",
                headers: { "Accept": "application/json" }
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
                errEl.textContent = data.message || "Failed to reset device";
                errEl.style.display = "block";
                btn.disabled = false;
                btn.textContent = "Confirm Reset";
                return;
            }

            closeModal("resetDeviceModal");
            showAlert(`Device ${activeResetTarget} reset successfully. Reloading...`, true);
            setTimeout(() => window.location.reload(), 700);
        } catch (err) {
            errEl.textContent = "Network error executing reset";
            errEl.style.display = "block";
            btn.disabled = false;
            btn.textContent = "Confirm Reset";
        }
    }

    // Delete Modal
    function openDeleteModal(deviceId) {
        activeDeleteTarget = deviceId;
        document.getElementById("deleteTargetDeviceId").textContent = deviceId;
        document.getElementById("deleteDeviceError").style.display = "none";
        openModal("deleteDeviceModal");
    }

    async function executeDeviceDelete() {
        if (!activeDeleteTarget) return;
        const btn = document.getElementById("confirmDeleteBtn");
        const errEl = document.getElementById("deleteDeviceError");
        errEl.style.display = "none";
        btn.disabled = true;
        btn.textContent = "Decommissioning...";

        try {
            const res = await fetch(`/api/admin/devices/${encodeURIComponent(activeDeleteTarget)}`, {
                method: "DELETE",
                headers: { "Accept": "application/json" }
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
                errEl.textContent = data.message || "Failed to delete device";
                errEl.style.display = "block";
                btn.disabled = false;
                btn.textContent = "Decommission Device";
                return;
            }

            closeModal("deleteDeviceModal");
            showAlert(`Device ${activeDeleteTarget} deleted successfully! Reloading...`, true);
            setTimeout(() => window.location.reload(), 700);
        } catch (err) {
            errEl.textContent = "Network error executing deletion";
            errEl.style.display = "block";
            btn.disabled = false;
            btn.textContent = "Decommission Device";
        }
    }

    // ========================================================
    // PHASE 12: REAL-TIME HEALTH DIAGNOSTICS & PERIODIC TIMER
    // ========================================================

    function formatRelativeTime(timestamp, now) {
        if (!timestamp) return "Never";
        const ageSeconds = Math.max(0, Math.floor((now - timestamp) / 1000));
        if (ageSeconds < 5) return "Just now";
        if (ageSeconds < 60) return `${ageSeconds}s ago`;
        if (ageSeconds < 120) return "1 minute ago";
        if (ageSeconds < 3600) return `${Math.floor(ageSeconds / 60)} minutes ago`;
        if (ageSeconds < 7200) return "1 hour ago";
        if (ageSeconds < 86400) return `${Math.floor(ageSeconds / 3600)} hours ago`;
        return `${Math.floor(ageSeconds / 86400)} days ago`;
    }

    function recalculateDeviceHealth() {
        const rows = document.querySelectorAll("tr[data-device-id]");
        const now = Date.now();

        rows.forEach(row => {
            const deviceId = row.dataset.deviceId;
            const status = (row.dataset.status || "ACTIVE").toUpperCase();
            const lastSeenStr = row.dataset.lastSeen;
            const badgeEl = document.getElementById(`health-badge-${deviceId}`);
            const textEl = document.getElementById(`health-text-${deviceId}`);
            const lastSeenTextEl = document.getElementById(`last-seen-text-${deviceId}`);

            if (!badgeEl || !textEl) return;

            let health = "OFFLINE";
            let formattedLastSeen = "Never";

            if (status !== "ACTIVE") {
                health = "OFFLINE";
                if (lastSeenStr) {
                    formattedLastSeen = formatRelativeTime(new Date(lastSeenStr).getTime(), now);
                }
            } else if (!lastSeenStr) {
                health = "OFFLINE";
                formattedLastSeen = "Never";
            } else {
                const lastSeenTime = new Date(lastSeenStr).getTime();
                if (isNaN(lastSeenTime)) {
                    health = "OFFLINE";
                    formattedLastSeen = "Never";
                } else {
                    const ageMs = now - lastSeenTime;
                    formattedLastSeen = formatRelativeTime(lastSeenTime, now);

                    // Boundaries: <60s -> ONLINE, 60s-599s -> STALE, >=600s -> OFFLINE
                    if (ageMs < 60 * 1000) {
                        health = "ONLINE";
                    } else if (ageMs < 600 * 1000) {
                        health = "STALE";
                    } else {
                        health = "OFFLINE";
                    }
                }
            }

            badgeEl.className = `telemetry-health-badge health-badge-${health.toLowerCase()}`;
            badgeEl.setAttribute("aria-label", `Device health: ${health}`);
            textEl.textContent = health;

            if (lastSeenTextEl && formattedLastSeen) {
                lastSeenTextEl.textContent = formattedLastSeen;
            }
        });
    }

    // Prevent duplicate timers
    if (window._deviceHealthTimer) {
        clearInterval(window._deviceHealthTimer);
    }
    window._deviceHealthTimer = setInterval(recalculateDeviceHealth, 5000);
    window.addEventListener("beforeunload", () => {
        if (window._deviceHealthTimer) {
            clearInterval(window._deviceHealthTimer);
        }
    });

    // Socket.IO real-time ingestion listener
    if (typeof io !== "undefined") {
        const socket = io({
            transports: ["websocket", "polling"],
            withCredentials: true
        });

        socket.on("sensor-reading", (data) => {
            if (!data || !data.deviceId) return;
            const row = document.getElementById(`row-${data.deviceId}`);
            if (!row) return;

            const nowIso = data.lastSeen || (data.timestamp ? new Date(data.timestamp).toISOString() : new Date().toISOString());
            row.dataset.lastSeen = nowIso;

            const isoEl = document.getElementById(`last-seen-iso-${data.deviceId}`);
            if (isoEl) {
                isoEl.textContent = new Date(nowIso).toLocaleTimeString();
            }

            recalculateDeviceHealth();

            // Subtle row flash effect
            row.style.transition = "background-color 0.4s ease";
            const origBg = row.style.backgroundColor;
            row.style.backgroundColor = "rgba(34, 197, 94, 0.08)";
            setTimeout(() => {
                row.style.backgroundColor = origBg;
            }, 600);
        });
    }
</script>
</body>
</html>
