<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthTrack — Super Admin Overview</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
    <%- include("partials/sidebar", { activePage, user }) %>

    <div class="admin-main">
        <%- include("partials/topbar", { 
            pageTitle: "System Overview", 
            pageSubtitle: "Centralized live operational metrics and hardware inventory aggregated from MongoDB",
            user 
        }) %>

        <main class="admin-content-body">
            <!-- System Metrics Grid -->
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-card-header">
                        <span class="metric-label">Total Patients</span>
                        <span class="metric-icon">👥</span>
                    </div>
                    <div class="metric-value highlight-orange" id="metric-total-patients"><%= metrics.totalPatients %></div>
                    <div class="metric-sub">Registered platform patients</div>
                </div>

                <div class="metric-card">
                    <div class="metric-card-header">
                        <span class="metric-label">Total Doctors</span>
                        <span class="metric-icon">👨‍⚕️</span>
                    </div>
                    <div class="metric-value" id="metric-total-doctors"><%= metrics.totalDoctors %></div>
                    <div class="metric-sub">Active clinical staff</div>
                </div>

                <div class="metric-card">
                    <div class="metric-card-header">
                        <span class="metric-label">Hardware Devices</span>
                        <span class="metric-icon">📟</span>
                    </div>
                    <div class="metric-value" id="metric-total-devices"><%= metrics.totalDevices %></div>
                    <div class="metric-sub">
                        <span class="highlight-green"><%= metrics.activeDevices %> Active</span> · 
                        <span><%= metrics.inactiveDevices %> Inactive</span>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-card-header">
                        <span class="metric-label">Device Assignment</span>
                        <span class="metric-icon">🔗</span>
                    </div>
                    <div class="metric-value" id="metric-assigned-devices"><%= metrics.assignedDevices %></div>
                    <div class="metric-sub">
                        <span><%= metrics.unassignedDevices %> Unassigned in inventory</span>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-card-header">
                        <span class="metric-label">User Accounts</span>
                        <span class="metric-icon">🔐</span>
                    </div>
                    <div class="metric-value highlight-green" id="metric-active-users"><%= metrics.activeUsers %></div>
                    <div class="metric-sub">
                        <span><%= metrics.suspendedUsers %> Suspended accounts</span>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-card-header">
                        <span class="metric-label">Telemetry Readings</span>
                        <span class="metric-icon">📈</span>
                    </div>
                    <div class="metric-value" id="metric-total-readings"><%= metrics.totalReadings %></div>
                    <div class="metric-sub">
                        <span><%= metrics.todayReadings %> captured today</span>
                    </div>
                </div>
            </div>

            <!-- Recent Patients Panel -->
            <section class="section-panel">
                <div class="panel-header">
                    <h2 class="panel-title">Recently Registered Patients</h2>
                    <span class="panel-badge">MongoDB Live</span>
                </div>

                <% if (!recentPatients || recentPatients.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-state-icon">👥</div>
                        <h3>No patients registered yet</h3>
                        <p>When patients enroll through the registration portal, their records will appear here.</p>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Patient ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Assigned Doctor</th>
                                    <th>Device</th>
                                    <th>Registered</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentPatients.forEach(p => { %>
                                    <tr>
                                        <td class="id-cell">
                                            <a href="/admin/view/patient/<%= p.patientId %>" style="color: var(--burnt-orange); text-decoration: none; font-weight: 700;" title="Open in Admin View Mode">
                                                <%= p.patientId %> 👁️
                                            </a>
                                        </td>
                                        <td><strong><%= p.name %></strong></td>
                                        <td><%= p.email %></td>
                                        <td>
                                            <% if (p.doctorId) { %>
                                                <a href="/admin/view/doctor/<%= p.doctorId %>" class="id-cell" style="text-decoration: none; color: inherit;" title="Open Doctor in View Mode"><%= p.doctorId %></a>
                                            <% } else { %>
                                                <span class="status-pill unassigned-pill">UNASSIGNED</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (p.deviceId) { %>
                                                <span class="id-cell"><%= p.deviceId %></span>
                                            <% } else { %>
                                                <span class="status-pill unassigned-pill">UNASSIGNED</span>
                                            <% } %>
                                        </td>
                                        <td><%= p.createdAt ? new Date(p.createdAt).toLocaleDateString() : "—" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <!-- Recent Doctors Panel -->
            <section class="section-panel">
                <div class="panel-header">
                    <h2 class="panel-title">Clinical Staff Overview</h2>
                    <span class="panel-badge"><%= recentDoctors ? recentDoctors.length : 0 %> Listed</span>
                </div>

                <% if (!recentDoctors || recentDoctors.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-state-icon">👨‍⚕️</div>
                        <h3>No doctors currently provisioned</h3>
                        <p>Doctors provisioned by administrative staff will be indexed in this registry.</p>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Doctor ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Specialty</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentDoctors.forEach(d => { %>
                                    <tr>
                                        <td class="id-cell">
                                            <a href="/admin/view/doctor/<%= d.doctorId %>" style="color: var(--burnt-orange); text-decoration: none; font-weight: 700;" title="Open in Admin View Mode">
                                                <%= d.doctorId %> 👁️
                                            </a>
                                        </td>
                                        <td><strong><%= d.name %></strong></td>
                                        <td><%= d.email %></td>
                                        <td><%= d.specialty || "General Medicine" %></td>
                                        <td>
                                            <span class="status-pill <%= d.status === 'ACTIVE' ? 'active-pill' : 'inactive-pill' %>">
                                                <%= d.status || "ACTIVE" %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>
        </main>
    </div>
</div>
</body>
</html>
