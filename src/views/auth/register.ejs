<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health Tracker — Patient Registration</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <header class="auth-header">
                <span class="auth-badge">Patient Enrollment</span>
                <h1 class="auth-title">Create Account</h1>
                <p class="auth-subtitle">Link your health monitor and begin telemetry</p>
            </header>

            <div id="authAlert" class="auth-alert"></div>

            <form id="registerForm" class="auth-form" novalidate>
                <div class="form-group">
                    <label class="form-label" for="name">Full Name *</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-input"
                        placeholder="e.g. John Doe"
                        required
                        autocomplete="name"
                    >
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="email">Email Address *</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-input"
                            placeholder="john@example.com"
                            required
                            autocomplete="email"
                        >
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="age">Age</label>
                        <input
                            type="number"
                            id="age"
                            name="age"
                            class="form-input"
                            placeholder="30"
                            min="0"
                            value="30"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="deviceId">
                        <span>Hardware Device ID *</span>
                        <span id="deviceCheckingSpinner" style="display: none; font-size: 0.75rem; color: var(--muted); font-weight: normal;">Validating...</span>
                    </label>
                    <input
                        type="text"
                        id="deviceId"
                        name="deviceId"
                        class="form-input"
                        placeholder="e.g. DEV-001, DEV-003"
                        required
                        autocomplete="off"
                        autocapitalize="characters"
                    >
                    <div id="deviceFeedback" class="device-feedback"></div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="password">Password *</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-input"
                            placeholder="Min. 6 chars"
                            required
                            autocomplete="new-password"
                        >
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirmPassword">Confirm Password *</label>
                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            class="form-input"
                            placeholder="Re-type password"
                            required
                            autocomplete="new-password"
                        >
                    </div>
                </div>

                <button type="submit" id="submitBtn" class="btn-primary">
                    Register & Claim Device
                </button>
            </form>

            <footer class="auth-footer">
                <p>Already have an account? <a href="/login">Sign in</a></p>
            </footer>
        </div>
    </div>

    <script>
        const form = document.getElementById("registerForm");
        const alertBox = document.getElementById("authAlert");
        const submitBtn = document.getElementById("submitBtn");
        const deviceInput = document.getElementById("deviceId");
        const deviceFeedback = document.getElementById("deviceFeedback");
        const deviceSpinner = document.getElementById("deviceCheckingSpinner");

        let debounceTimer = null;
        let lastValidatedId = "";
        let isDeviceClaimable = false;

        // Debounced real-time device claim validation
        deviceInput.addEventListener("input", () => {
            const rawVal = deviceInput.value.trim().toUpperCase();
            clearTimeout(debounceTimer);

            if (!rawVal) {
                deviceFeedback.className = "device-feedback";
                deviceFeedback.textContent = "";
                deviceInput.classList.remove("input-claimable", "input-error");
                deviceSpinner.style.display = "none";
                isDeviceClaimable = false;
                lastValidatedId = "";
                return;
            }

            deviceSpinner.style.display = "inline";
            deviceFeedback.className = "device-feedback active loading";
            deviceFeedback.textContent = "Checking device availability...";

            debounceTimer = setTimeout(async () => {
                await checkDeviceStatus(rawVal);
            }, 350);
        });

        async function checkDeviceStatus(cleanId) {
            lastValidatedId = cleanId;
            try {
                const res = await fetch(`/api/auth/device-status/${encodeURIComponent(cleanId)}`);
                const data = await res.json();
                deviceSpinner.style.display = "none";

                // Ensure input hasn't changed while awaiting response
                if (deviceInput.value.trim().toUpperCase() !== cleanId) return;

                if (data.claimable) {
                    isDeviceClaimable = true;
                    deviceInput.classList.remove("input-error");
                    deviceInput.classList.add("input-claimable");
                    deviceFeedback.className = "device-feedback active claimable";
                    deviceFeedback.textContent = `✓ ${data.message || "This device is ready to be assigned."}`;
                } else {
                    isDeviceClaimable = false;
                    deviceInput.classList.remove("input-claimable");
                    deviceInput.classList.add("input-error");
                    deviceFeedback.className = "device-feedback active error";
                    deviceFeedback.textContent = `✗ ${data.message || "Device cannot be claimed."}`;
                }
            } catch (err) {
                deviceSpinner.style.display = "none";
                isDeviceClaimable = false;
                deviceInput.classList.remove("input-claimable");
                deviceFeedback.className = "device-feedback active error";
                deviceFeedback.textContent = "✗ Network error verifying device.";
            }
        }

        // Form submission & full client validation
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            alertBox.className = "auth-alert";
            alertBox.textContent = "";

            const name = document.getElementById("name").value.trim();
            const email = document.getElementById("email").value.trim().toLowerCase();
            const age = Number(document.getElementById("age").value);
            const deviceId = deviceInput.value.trim().toUpperCase();
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            if (!name) {
                alertBox.className = "auth-alert error";
                alertBox.textContent = "Please enter your full name.";
                return;
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!email || !emailRegex.test(email)) {
                alertBox.className = "auth-alert error";
                alertBox.textContent = "Please provide a valid email address.";
                return;
            }

            if (!deviceId) {
                alertBox.className = "auth-alert error";
                alertBox.textContent = "Hardware device ID is required.";
                return;
            }

            if (!password || password.length < 6) {
                alertBox.className = "auth-alert error";
                alertBox.textContent = "Password must be at least 6 characters long.";
                return;
            }

            if (password !== confirmPassword) {
                alertBox.className = "auth-alert error";
                alertBox.textContent = "Passwords do not match.";
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = "Enrolling patient...";

            try {
                const res = await fetch("/api/auth/register", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ name, email, age, deviceId, password, confirmPassword })
                });

                const data = await res.json();

                if (!res.ok || !data.success) {
                    alertBox.className = "auth-alert error";
                    alertBox.textContent = data.message || "Registration failed. Please check your details.";
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Register & Claim Device";
                    return;
                }

                alertBox.className = "auth-alert success";
                alertBox.textContent = "Registration successful! Redirecting to your dashboard...";

                setTimeout(() => {
                    if (data.patient && data.patient.patientId) {
                        window.location.href = `/patient/${data.patient.patientId}`;
                    } else {
                        window.location.href = "/login";
                    }
                }, 700);
            } catch (err) {
                alertBox.className = "auth-alert error";
                alertBox.textContent = "Network error. Please try again.";
                submitBtn.disabled = false;
                submitBtn.textContent = "Register & Claim Device";
            }
        });
    </script>
</body>
</html>
