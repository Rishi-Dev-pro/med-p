<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthTrack — Doctor Overview</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/doctor.css">
</head>
<body>
    <div class="app-shell">
        <%- include("partials/sidebar", { activePage, user, doctor }) %>

        <main class="main-content">
            <%- include("partials/topbar", { 
                pageEyebrow: "PHYSICIAN DASHBOARD", 
                pageTitle: "Clinical Practice Overview", 
                doctor 
            }) %>

            <!-- Summary KPI Cards -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 28px;">
                <div style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">ASSIGNED PATIENTS</span>
                        <span style="font-size: 18px;">👥</span>
                    </div>
                    <div style="font-size: 36px; font-weight: 800; color: var(--text);"><%= metrics.totalPatients %></div>
                    <span style="font-size: 12px; color: var(--muted);">Under your clinical care</span>
                </div>

                <div style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">ACTIVE HARDWARE</span>
                        <span style="font-size: 18px;">📟</span>
                    </div>
                    <div style="font-size: 36px; font-weight: 800; color: #60A5FA;"><%= metrics.activeDevices %></div>
                    <span style="font-size: 12px; color: var(--muted);">Telemetry devices paired</span>
                </div>

                <div style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">RECENT TELEMETRY</span>
                        <span style="font-size: 18px;">⚡</span>
                    </div>
                    <div style="font-size: 36px; font-weight: 800; color: var(--burnt-orange);"><%= metrics.recentTelemetryCount %></div>
                    <span style="font-size: 12px; color: var(--muted);">Recent biometric packets</span>
                </div>
            </div>

            <!-- Assigned Patients Snapshot -->
            <section style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 24px; margin-bottom: 28px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div>
                        <h3 style="font-size: 16px; font-weight: 700;">Assigned Patients Roster</h3>
                        <p style="font-size: 12px; color: var(--muted); margin-top: 2px;">Your authorized clinical care cohort</p>
                    </div>
                    <a href="/doctor/patients" style="font-size: 12px; color: #60A5FA; text-decoration: none; font-weight: 600;">View Full Roster &rarr;</a>
                </div>

                <% if (!patients || patients.length === 0) { %>
                    <div style="padding: 32px; text-align: center; color: var(--muted);">
                        <p style="font-size: 13px;">No patients are currently assigned to your clinical care.</p>
                        <span style="font-size: 11px; color: var(--muted);">The Super Admin will assign platform patients to your care cohort.</span>
                    </div>
                <% } else { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--border); color: var(--muted); font-size: 11px; text-transform: uppercase;">
                                    <th style="padding: 10px 14px;">Patient ID</th>
                                    <th style="padding: 10px 14px;">Name</th>
                                    <th style="padding: 10px 14px;">Demographics</th>
                                    <th style="padding: 10px 14px;">Device ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% patients.slice(0, 5).forEach(p => { %>
                                    <tr style="border-bottom: 1px solid rgba(255,244,214,0.04);">
                                        <td style="padding: 12px 14px;"><span class="id-cell" style="font-size: 12px;"><%= p.patientId %></span></td>
                                        <td style="padding: 12px 14px; font-weight: 600;"><%= p.name %></td>
                                        <td style="padding: 12px 14px; color: var(--muted);"><%= p.age %> yrs · <%= p.gender || 'unspecified' %></td>
                                        <td style="padding: 12px 14px;">
                                            <% if (p.deviceId) { %>
                                                <span class="id-cell" style="font-size: 12px;"><%= p.deviceId %></span>
                                            <% } else { %>
                                                <span style="color: var(--muted); font-size: 11px;">None</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>
        </main>
    </div>
</body>
</html>
