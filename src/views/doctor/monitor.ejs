<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthTrack — Clinical Live Monitor</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/doctor.css">
</head>
<body>
    <div class="app-shell">
        <%- include("partials/sidebar", { activePage, user, doctor }) %>

        <main class="main-content">
            <%- include("partials/topbar", { 
                pageEyebrow: "BIOMETRIC SURVEILLANCE", 
                pageTitle: "Real-Time Telemetry Monitor", 
                doctor 
            }) %>

            <!-- Socket Status Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: 24px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span id="doctorSocketDot" class="status-dot"></span>
                    <span id="doctorSocketText" style="font-size: 13px; font-weight: 600; color: #69D48B;">Connecting to clinical telemetry network...</span>
                </div>
                <div style="font-size: 12px; color: var(--muted);">
                    Authorized Clinical Channel: <span class="id-cell" style="font-size: 11px;">doctor:<%= doctor.doctorId %></span>
                </div>
            </div>

            <!-- Patient Telemetry Grid -->
            <% if (!patients || patients.length === 0) { %>
                <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 48px; text-align: center; color: var(--muted);">
                    <div style="font-size: 36px; margin-bottom: 12px;">📡</div>
                    <h3 style="font-size: 16px; color: var(--text); margin-bottom: 6px;">No patients assigned</h3>
                    <p style="font-size: 13px;">When patients with active telemetry hardware are assigned to your care, live monitor cards will appear here.</p>
                </div>
            <% } else { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; margin-bottom: 30px;">
                    <% patients.forEach(p => { %>
                        <div id="patient-card-<%= p.patientId %>" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; transition: border-color 0.25s ease;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                                <div>
                                    <div style="font-size: 16px; font-weight: 700; color: var(--text);"><%= p.name %></div>
                                    <div class="id-cell" style="font-size: 11px; margin-top: 2px;"><%= p.patientId %> · <%= p.age %> yrs</div>
                                </div>
                                <div style="text-align: right;">
                                    <% if (p.device) { %>
                                        <span class="id-cell" style="font-size: 11px;"><%= p.device.deviceId %></span>
                                    <% } else { %>
                                        <span style="font-size: 11px; color: var(--muted);">No device</span>
                                    <% } %>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                                <div style="padding: 14px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px;">
                                    <div style="font-size: 10px; color: var(--muted); text-transform: uppercase; font-weight: 700;">HEART RATE</div>
                                    <div id="hr-<%= p.patientId %>" style="font-size: 28px; font-weight: 800; color: var(--text); margin-top: 4px; font-variant-numeric: tabular-nums;">
                                        <%= p.latestReading ? p.latestReading.value1 : '--' %>
                                    </div>
                                    <div style="font-size: 10px; color: var(--muted);">bpm</div>
                                </div>

                                <div style="padding: 14px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px;">
                                    <div style="font-size: 10px; color: var(--burnt-orange); text-transform: uppercase; font-weight: 700;">BLOOD OXYGEN</div>
                                    <div id="spo2-<%= p.patientId %>" style="font-size: 28px; font-weight: 800; color: var(--burnt-orange); margin-top: 4px; font-variant-numeric: tabular-nums;">
                                        <%= p.latestReading ? p.latestReading.value2 : '--' %>
                                    </div>
                                    <div style="font-size: 10px; color: var(--muted);">SpO₂ %</div>
                                </div>
                            </div>

                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--muted); border-top: 1px solid rgba(255,255,255,0.04); padding-top: 12px;">
                                <span>Last Sync: <span id="time-<%= p.patientId %>"><%= p.latestReading ? new Date(p.latestReading.timestamp).toLocaleTimeString() : 'Never' %></span></span>
                                <a href="/doctor/history?patientId=<%= p.patientId %>" style="color: #60A5FA; text-decoration: none; font-weight: 600;">History &rarr;</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </main>
    </div>

    <!-- Socket.IO Client -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const statusDot = document.getElementById("doctorSocketDot");
        const statusText = document.getElementById("doctorSocketText");

        if (typeof io !== "undefined") {
            const socket = io({
                transports: ["websocket", "polling"],
                withCredentials: true
            });

            socket.on("connect", () => {
                if (statusDot) {
                    statusDot.style.background = "#69D48B";
                    statusDot.style.boxShadow = "0 0 12px rgba(105, 212, 139, 0.7)";
                }
                if (statusText) {
                    statusText.textContent = "Clinical Telemetry Network Online";
                    statusText.style.color = "#69D48B";
                }
            });

            socket.on("connect_error", () => {
                if (statusDot) {
                    statusDot.style.background = "#F87171";
                    statusDot.style.boxShadow = "none";
                }
                if (statusText) {
                    statusText.textContent = "Reconnecting to clinical network...";
                    statusText.style.color = "#F87171";
                }
            });

            socket.on("sensor-reading", (data) => {
                if (!data || !data.patientId) return;

                const hrEl = document.getElementById(`hr-${data.patientId}`);
                const spo2El = document.getElementById(`spo2-${data.patientId}`);
                const timeEl = document.getElementById(`time-${data.patientId}`);
                const cardEl = document.getElementById(`patient-card-${data.patientId}`);

                if (hrEl && data.value1 !== undefined) {
                    hrEl.textContent = data.value1;
                }
                if (spo2El && data.value2 !== undefined) {
                    spo2El.textContent = data.value2;
                }
                if (timeEl && data.timestamp) {
                    timeEl.textContent = new Date(data.timestamp).toLocaleTimeString();
                }

                if (cardEl) {
                    cardEl.style.borderColor = "var(--burnt-orange)";
                    setTimeout(() => {
                        cardEl.style.borderColor = "var(--border)";
                    }, 800);
                }
            });
        }
    });
    </script>
</body>
</html>
