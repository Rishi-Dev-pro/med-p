<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthTrack — Clinical History</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/doctor.css">
</head>
<body>
    <div class="app-shell">
        <%- include("partials/sidebar", { activePage, user, doctor }) %>

        <main class="main-content">
            <%- include("partials/topbar", { 
                pageEyebrow: "CLINICAL AUDIT", 
                pageTitle: "Historical Telemetry Archives", 
                doctor 
            }) %>

            <!-- Patient Filter & Date Controls Bar -->
            <div style="margin-bottom: 24px; padding: 18px 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                <form action="/doctor/history" method="GET" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin: 0;">
                    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <label for="patientFilter" style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em;">Patient:</label>
                            <select id="patientFilter" name="patientId" style="padding: 7px 12px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 13px;">
                                <option value="">-- All Assigned Patients --</option>
                                <% if (typeof assignedPatients !== 'undefined' && assignedPatients) { %>
                                    <% assignedPatients.forEach(p => { %>
                                        <option value="<%= p.patientId %>" <%= (typeof selectedPatientId !== 'undefined' && selectedPatientId === p.patientId) ? 'selected' : '' %>>
                                            <%= p.name %> (<%= p.patientId %>)
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div style="display: flex; align-items: center; gap: 8px;">
                            <label for="startDate" style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em;">From:</label>
                            <input type="date" id="startDate" name="startDate" value="<%= typeof startDate !== 'undefined' ? startDate : '' %>" style="padding: 7px 12px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 13px;">
                        </div>

                        <div style="display: flex; align-items: center; gap: 8px;">
                            <label for="endDate" style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em;">To:</label>
                            <input type="date" id="endDate" name="endDate" value="<%= typeof endDate !== 'undefined' ? endDate : '' %>" style="padding: 7px 12px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 13px;">
                        </div>

                        <button type="submit" style="padding: 7px 16px; background: var(--burnt-orange); border: none; border-radius: 6px; color: #fff; font-size: 12px; font-weight: 700; cursor: pointer;">
                            Apply Filter
                        </button>

                        <% if ((typeof selectedPatientId !== 'undefined' && selectedPatientId) || (typeof startDate !== 'undefined' && startDate) || (typeof endDate !== 'undefined' && endDate)) { %>
                            <a href="/doctor/history" style="padding: 7px 12px; background: rgba(255,255,255,0.08); border-radius: 6px; color: var(--muted); font-size: 12px; text-decoration: none;">
                                Clear Filter
                            </a>
                        <% } %>
                    </div>

                    <div style="display: flex; align-items: center; gap: 12px;">
                        <button type="button" onclick="alert('CSV export coming soon (Scheduled for future telemetry enhancements).')" style="padding: 7px 14px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                            <span>📥</span> Export CSV (Stub)
                        </button>
                        <div style="font-size: 12px; color: var(--muted);">
                            Total: <strong style="color: var(--text);"><%= (typeof pagination !== 'undefined' && pagination.total) ? pagination.total : (readings ? readings.length : 0) %></strong> records
                        </div>
                    </div>
                </form>
            </div>

            <!-- Historical Readings Table -->
            <section style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div>
                        <h2 style="font-size: 18px; font-weight: 700;">Biometric Reading Records</h2>
                        <p style="font-size: 12px; color: var(--muted); margin-top: 4px;">Historical telemetry logs from assigned clinical caseload</p>
                    </div>
                    <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
                        <span style="padding: 4px 12px; background: rgba(255,255,255,0.06); border-radius: 999px; font-size: 12px; color: var(--muted);">
                            Page <%= pagination.page %> of <%= pagination.pages %>
                        </span>
                    <% } %>
                </div>

                <% if (!readings || readings.length === 0) { %>
                    <div style="padding: 48px; text-align: center; color: var(--muted);">
                        <div style="font-size: 36px; margin-bottom: 12px;">📈</div>
                        <h3 style="font-size: 16px; color: var(--text); margin-bottom: 6px;">No historical telemetry records found</h3>
                        <p style="font-size: 13px;">Telemetry snapshots from assigned patients will be logged and listed here chronologically.</p>
                    </div>
                <% } else { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--border); color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">
                                    <th style="padding: 12px 14px;">Timestamp</th>
                                    <th style="padding: 12px 14px;">Patient ID</th>
                                    <th style="padding: 12px 14px;">Heart Rate</th>
                                    <th style="padding: 12px 14px;">Blood Oxygen</th>
                                    <th style="padding: 12px 14px;">Device ID</th>
                                    <th style="padding: 12px 14px; text-align: right;">Reading ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% readings.forEach(r => { %>
                                    <tr style="border-bottom: 1px solid rgba(255,244,214,0.04); transition: background 0.15s ease;">
                                        <td style="padding: 14px 14px;">
                                            <div><%= new Date(r.timestamp).toLocaleDateString() %></div>
                                            <div style="font-size: 11px; color: var(--muted);"><%= new Date(r.timestamp).toLocaleTimeString() %></div>
                                        </td>
                                        <td style="padding: 14px 14px;">
                                            <span class="id-cell" style="font-size: 12px; font-weight: 700;"><%= r.patientId %></span>
                                        </td>
                                        <td style="padding: 14px 14px; font-weight: 700; color: var(--text);">
                                            <%= r.value1 %> <span style="font-size: 11px; font-weight: 400; color: var(--muted);">bpm</span>
                                        </td>
                                        <td style="padding: 14px 14px; font-weight: 700; color: var(--burnt-orange);">
                                            <%= r.value2 %> <span style="font-size: 11px; font-weight: 400; color: var(--muted);">%</span>
                                        </td>
                                        <td style="padding: 14px 14px;">
                                            <span class="id-cell" style="font-size: 12px;"><%= r.deviceId %></span>
                                        </td>
                                        <td style="padding: 14px 14px; text-align: right;">
                                            <span style="font-family: monospace; font-size: 11px; color: var(--muted);"><%= r._id ? r._id.toString().slice(-8) : '—' %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Controls -->
                    <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--border);">
                            <div>
                                <% if (pagination.page > 1) { %>
                                    <a href="/doctor/history?page=<%= pagination.page - 1 %><%= typeof pagination !== 'undefined' && pagination.limit ? '&limit=' + pagination.limit : '' %><%= typeof selectedPatientId !== 'undefined' && selectedPatientId ? '&patientId=' + encodeURIComponent(selectedPatientId) : '' %><%= typeof startDate !== 'undefined' && startDate ? '&startDate=' + encodeURIComponent(startDate) : '' %><%= typeof endDate !== 'undefined' && endDate ? '&endDate=' + encodeURIComponent(endDate) : '' %>" 
                                       style="padding: 8px 16px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 12px; font-weight: 600; text-decoration: none;">
                                        ← Previous Page
                                    </a>
                                <% } else { %>
                                    <span style="padding: 8px 16px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; color: var(--muted); font-size: 12px; cursor: not-allowed;">
                                        ← Previous Page
                                    </span>
                                <% } %>
                            </div>

                            <span style="font-size: 12px; color: var(--muted);">
                                Page <strong style="color: var(--text);"><%= pagination.page %></strong> of <strong style="color: var(--text);"><%= pagination.pages %></strong> (<%= pagination.total %> Total Records)
                            </span>

                            <div>
                                <% if (pagination.page < pagination.pages) { %>
                                    <a href="/doctor/history?page=<%= pagination.page + 1 %><%= typeof pagination !== 'undefined' && pagination.limit ? '&limit=' + pagination.limit : '' %><%= typeof selectedPatientId !== 'undefined' && selectedPatientId ? '&patientId=' + encodeURIComponent(selectedPatientId) : '' %><%= typeof startDate !== 'undefined' && startDate ? '&startDate=' + encodeURIComponent(startDate) : '' %><%= typeof endDate !== 'undefined' && endDate ? '&endDate=' + encodeURIComponent(endDate) : '' %>" 
                                       style="padding: 8px 16px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 12px; font-weight: 600; text-decoration: none;">
                                        Next Page →
                                    </a>
                                <% } else { %>
                                    <span style="padding: 8px 16px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; color: var(--muted); font-size: 12px; cursor: not-allowed;">
                                        Next Page →
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </section>
        </main>
    </div>
</body>
</html>
