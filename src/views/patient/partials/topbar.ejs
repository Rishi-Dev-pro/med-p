<!-- ==========================================
     PATIENT PORTAL TOPBAR
     ========================================== -->
<header class="topbar">
    <div>
        <span class="eyebrow" style="color: var(--burnt-orange); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700;"><%= pageEyebrow || "PATIENT PORTAL" %></span>
        <h1 style="font-size: 26px; font-weight: 700; margin-top: 4px; color: var(--text);"><%= pageTitle || ("Hello, " + patient.name) %></h1>
    </div>

    <div style="display: flex; align-items: center; gap: 14px;">
        <% if (patient.deviceId) { %>
            <div style="display: flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(105, 212, 139, 0.1); border: 1px solid rgba(105, 212, 139, 0.25); border-radius: 999px; font-size: 12px; color: #69D48B; font-weight: 600;">
                <span class="status-dot"></span>
                <span>DEVICE <%= patient.deviceId %></span>
            </div>
        <% } else { %>
            <div style="display: flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 999px; font-size: 12px; color: #FBBF24; font-weight: 600;">
                <span>⚠️</span>
                <span>NO DEVICE PAIRED</span>
            </div>
        <% } %>
    </div>
</header>
