<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthTrack — Patient Overview</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/patient.css">
</head>
<body>
    <div class="app-shell">
        <%- include("partials/sidebar", { activePage, user }) %>

        <main class="main-content">
            <%- include("partials/topbar", { 
                pageEyebrow: "PATIENT DASHBOARD", 
                pageTitle: "Overview & Clinical Status", 
                patient 
            }) %>

            <!-- Hero Device Card -->
            <section class="hero-card" style="display: flex; justify-content: space-between; align-items: center; padding: 28px 32px; background: linear-gradient(135deg, rgba(252, 108, 38, 0.12) 0%, rgba(26, 24, 21, 0.9) 100%); border: 1px solid rgba(252, 108, 38, 0.25); border-radius: var(--radius-lg); margin-bottom: 28px;">
                <div>
                    <span class="eyebrow" style="color: var(--burnt-orange); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">TELEMETRY HARDWARE</span>
                    <h2 style="font-size: 24px; margin: 6px 0 8px; color: var(--text);">
                        <%= device ? device.deviceId : 'No Device Linked' %>
                    </h2>
                    <p style="color: var(--muted); font-size: 13px; max-width: 500px; line-height: 1.5;">
                        <% if (device && device.status === 'ACTIVE') { %>
                            Your health tracker unit is registered and transmitting encrypted biometric telemetry.
                        <% } else if (device) { %>
                            Your device is currently inactive. Contact your clinical provider or support.
                        <% } else { %>
                            No hardware telemetry device is currently paired with your profile.
                        <% } %>
                    </p>
                </div>

                <div style="text-align: right;">
                    <div style="font-size: 11px; color: var(--muted); text-transform: uppercase; margin-bottom: 6px;">Care Physician</div>
                    <div style="font-size: 16px; font-weight: 700; color: var(--text);">
                        <%= doctor ? doctor.name : 'Unassigned' %>
                    </div>
                    <div style="font-size: 12px; color: var(--muted);">
                        <%= doctor ? (doctor.specialization || 'Clinical Specialist') : 'Awaiting physician assignment' %>
                    </div>
                </div>
            </section>

            <!-- Metrics Grid -->
            <section class="metrics-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 28px;">
                <article class="metric-card" style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                    <span class="metric-label" style="font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">HEART RATE (VALUE 01)</span>
                    <div style="font-size: 38px; font-weight: 800; color: var(--text); margin: 12px 0 6px;">
                        <span id="chartLatestValue1"><%= latestReading ? latestReading.value1 : '--' %></span>
                        <span style="font-size: 16px; font-weight: 400; color: var(--muted);">bpm</span>
                    </div>
                    <span class="metric-state" style="font-size: 12px; color: var(--muted);">
                        <%= latestReading ? 'Latest verified reading' : 'Awaiting data transmission' %>
                    </span>
                </article>

                <article class="metric-card" style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                    <span class="metric-label" style="font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">BLOOD OXYGEN (VALUE 02)</span>
                    <div style="font-size: 38px; font-weight: 800; color: var(--burnt-orange); margin: 12px 0 6px;">
                        <span id="chartLatestValue2"><%= latestReading ? latestReading.value2 : '--' %></span>
                        <span style="font-size: 16px; font-weight: 400; color: var(--muted);">%</span>
                    </div>
                    <span class="metric-state" style="font-size: 12px; color: var(--muted);">
                        <%= latestReading ? 'Measured via pulse oximeter' : 'Awaiting data transmission' %>
                    </span>
                </article>

                <article class="metric-card" style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                    <span class="metric-label" style="font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">LAST SYNCED</span>
                    <div style="font-size: 18px; font-weight: 700; color: var(--text); margin: 16px 0 8px;">
                        <%= latestReading ? new Date(latestReading.timestamp).toLocaleTimeString() : 'Never' %>
                    </div>
                    <span class="metric-state" style="font-size: 12px; color: var(--muted);">
                        <%= latestReading ? new Date(latestReading.timestamp).toLocaleDateString() : 'No readings stored' %>
                    </span>
                </article>
            </section>

            <!-- Phase 11: Real-Time & Historical Telemetry Chart -->
            <section id="patientChartContainer" data-patient-id="<%= patient.patientId %>" style="margin-bottom: 28px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; position: relative;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <span class="eyebrow" style="color: var(--burnt-orange); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">BIOMETRIC TELEMETRY TIME-SERIES</span>
                        <h2 style="font-size: 20px; font-weight: 700; margin: 4px 0 0; color: var(--text);">Heart Rate & Blood Oxygen Trends</h2>
                    </div>
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <span id="chartSyncBadge" style="padding: 4px 12px; background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 999px; font-size: 12px; font-weight: 600; color: var(--muted);">
                            Connecting...
                        </span>
                    </div>
                </div>

                <!-- Chart Canvas Container -->
                <div style="position: relative; width: 100%; height: 320px;">
                    <!-- Loading State -->
                    <div id="chartLoading" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--muted); gap: 12px;">
                        <div style="font-size: 28px; animation: pulse 1.5s infinite;">📈</div>
                        <div style="font-size: 14px; font-weight: 600;">Loading telemetry...</div>
                    </div>

                    <!-- Empty State -->
                    <div id="chartEmpty" style="display: none; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--muted); gap: 12px;">
                        <div style="font-size: 32px;">📊</div>
                        <div style="font-size: 15px; font-weight: 600; color: var(--text);">No telemetry data available yet.</div>
                        <p style="font-size: 12px; color: var(--muted); margin: 0; max-width: 380px; text-align: center;">
                            Real-time biometric points will populate the chart automatically when device transmissions arrive.
                        </p>
                    </div>

                    <!-- Error State -->
                    <div id="chartError" style="display: none; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--muted); gap: 10px;">
                        <div style="font-size: 30px; color: #F87171;">⚠️</div>
                        <div class="error-message" style="font-size: 14px; font-weight: 600; color: #F87171;">Unable to load telemetry history.</div>
                    </div>

                    <!-- Interactive Chart Canvas -->
                    <canvas id="patientTelemetryChart" style="display: none; width: 100%; height: 100%;"></canvas>
                </div>
            </section>

            <!-- Navigation Shortcuts -->
            <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                <div style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                    <h3 style="font-size: 16px; margin-bottom: 8px;">⚡ Live Telemetry Stream</h3>
                    <p style="font-size: 13px; color: var(--muted); margin-bottom: 16px; line-height: 1.5;">
                        Connect to real-time biometric telemetry stream updated over Socket.IO.
                    </p>
                    <a href="/patient/live" style="display: inline-block; padding: 8px 16px; background: rgba(252, 108, 38, 0.15); color: var(--burnt-orange); border: 1px solid rgba(252, 108, 38, 0.3); border-radius: 8px; font-size: 13px; text-decoration: none; font-weight: 600;">
                        Open Live Monitor &rarr;
                    </a>
                </div>

                <div style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                    <h3 style="font-size: 16px; margin-bottom: 8px;">📈 Reading History</h3>
                    <p style="font-size: 13px; color: var(--muted); margin-bottom: 16px; line-height: 1.5;">
                        Inspect historical biometric readings and chronological data logs.
                    </p>
                    <a href="/patient/history" style="display: inline-block; padding: 8px 16px; background: rgba(255, 255, 255, 0.05); color: var(--text); border: 1px solid var(--border); border-radius: 8px; font-size: 13px; text-decoration: none; font-weight: 600;">
                        View Reading History &rarr;
                    </a>
                </div>
            </section>
        </main>
    </div>

    <!-- Phase 11 Chart Visualization Scripts -->
    <script src="/js/chart.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/chartSanitizer.js"></script>
    <script src="/js/patientCharts.js"></script>
</body>
</html>
