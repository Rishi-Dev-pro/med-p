<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HealthTrack — Reading History</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/patient.css">
</head>
<body>
    <%- include("../admin/partials/adminViewBanner") %>
    <div class="app-shell">
        <%- include("partials/sidebar", { activePage, user }) %>

        <main class="main-content">
            <%- include("partials/topbar", { 
                pageEyebrow: "CHRONOLOGICAL LOGS", 
                pageTitle: "Biometric Reading History", 
                patient 
            }) %>

            <!-- Filters & Actions Bar -->
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; padding: 18px 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
                <form action="/patient/history" method="GET" style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 0;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <label for="startDate" style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em;">From:</label>
                        <input type="date" id="startDate" name="startDate" value="<%= typeof startDate !== 'undefined' ? startDate : '' %>" style="padding: 7px 12px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 13px;">
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <label for="endDate" style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em;">To:</label>
                        <input type="date" id="endDate" name="endDate" value="<%= typeof endDate !== 'undefined' ? endDate : '' %>" style="padding: 7px 12px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 13px;">
                    </div>
                    <button type="submit" style="padding: 7px 16px; background: var(--burnt-orange); border: none; border-radius: 6px; color: #fff; font-size: 12px; font-weight: 700; cursor: pointer; transition: opacity 0.15s ease;">
                        Apply Filter
                    </button>
                    <% if ((typeof startDate !== 'undefined' && startDate) || (typeof endDate !== 'undefined' && endDate)) { %>
                        <a href="/patient/history" style="padding: 7px 12px; background: rgba(255,255,255,0.08); border-radius: 6px; color: var(--muted); font-size: 12px; text-decoration: none;">
                            Clear Filter
                        </a>
                    <% } %>
                </form>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <button type="button" onclick="alert('CSV export coming soon (Scheduled for future telemetry enhancements).')" style="padding: 7px 14px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                        <span>📥</span> Export CSV (Stub)
                    </button>
                    <span style="font-size: 12px; color: var(--muted);">
                        Total: <strong style="color: var(--text);"><%= (typeof pagination !== 'undefined' && pagination.total) ? pagination.total : (readings ? readings.length : 0) %></strong> records
                    </span>
                </div>
            </div>

            <!-- Historical Readings Table Panel -->
            <section class="section-panel" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div>
                        <h2 style="font-size: 18px; font-weight: 700;">Recorded Biometric Sessions</h2>
                        <p style="font-size: 12px; color: var(--muted); margin-top: 4px;">Chronological snapshots captured by your assigned telemetry unit</p>
                    </div>
                    <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
                        <span style="padding: 4px 12px; background: rgba(255,255,255,0.06); border-radius: 999px; font-size: 12px; color: var(--muted);">
                            Page <%= pagination.page %> of <%= pagination.pages %>
                        </span>
                    <% } %>
                </div>

                <% if (!readings || readings.length === 0) { %>
                    <div style="padding: 48px; text-align: center; color: var(--muted);">
                        <div style="font-size: 36px; margin-bottom: 12px;">📊</div>
                        <h3 style="font-size: 16px; color: var(--text); margin-bottom: 6px;">No historical telemetry recorded</h3>
                        <p style="font-size: 13px;">When your paired device sends sensor readings, they will appear here in chronological order.</p>
                    </div>
                <% } else { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--border); color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">
                                    <th style="padding: 12px 16px;">Timestamp</th>
                                    <th style="padding: 12px 16px;">Heart Rate (Val 1)</th>
                                    <th style="padding: 12px 16px;">Blood Oxygen (Val 2)</th>
                                    <th style="padding: 12px 16px;">Device ID</th>
                                    <th style="padding: 12px 16px;">Doctor ID Snapshot</th>
                                    <th style="padding: 12px 16px; text-align: right;">Reading ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% readings.forEach(r => { %>
                                    <tr style="border-bottom: 1px solid rgba(255,244,214,0.05); transition: background 0.15s ease;">
                                        <td style="padding: 14px 16px; font-weight: 500;">
                                            <div><%= new Date(r.timestamp).toLocaleDateString() %></div>
                                            <div style="font-size: 11px; color: var(--muted);"><%= new Date(r.timestamp).toLocaleTimeString() %></div>
                                        </td>
                                        <td style="padding: 14px 16px; font-weight: 700; color: var(--text);">
                                            <%= r.value1 %> <span style="font-size: 11px; font-weight: 400; color: var(--muted);">bpm</span>
                                        </td>
                                        <td style="padding: 14px 16px; font-weight: 700; color: var(--burnt-orange);">
                                            <%= r.value2 %> <span style="font-size: 11px; font-weight: 400; color: var(--muted);">%</span>
                                        </td>
                                        <td style="padding: 14px 16px;">
                                            <span class="id-cell" style="font-size: 12px;"><%= r.deviceId %></span>
                                        </td>
                                        <td style="padding: 14px 16px;">
                                            <% if (r.doctorId) { %>
                                                <span class="id-cell" style="font-size: 12px;"><%= r.doctorId %></span>
                                            <% } else { %>
                                                <span style="color: var(--muted); font-size: 11px;">Unassigned</span>
                                            <% } %>
                                        </td>
                                        <td style="padding: 14px 16px; text-align: right;">
                                            <span style="font-family: monospace; font-size: 11px; color: var(--muted);"><%= r._id ? r._id.toString().slice(-8) : '—' %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Controls -->
                    <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--border);">
                            <div>
                                <% if (pagination.page > 1) { %>
                                    <a href="/patient/history?page=<%= pagination.page - 1 %><%= typeof pagination !== 'undefined' && pagination.limit ? '&limit=' + pagination.limit : '' %><%= typeof startDate !== 'undefined' && startDate ? '&startDate=' + encodeURIComponent(startDate) : '' %><%= typeof endDate !== 'undefined' && endDate ? '&endDate=' + encodeURIComponent(endDate) : '' %>" 
                                       style="padding: 8px 16px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 12px; font-weight: 600; text-decoration: none;">
                                        ← Previous Page
                                    </a>
                                <% } else { %>
                                    <span style="padding: 8px 16px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; color: var(--muted); font-size: 12px; cursor: not-allowed;">
                                        ← Previous Page
                                    </span>
                                <% } %>
                            </div>

                            <span style="font-size: 12px; color: var(--muted);">
                                Page <strong style="color: var(--text);"><%= pagination.page %></strong> of <strong style="color: var(--text);"><%= pagination.pages %></strong> (<%= pagination.total %> Total Records)
                            </span>

                            <div>
                                <% if (pagination.page < pagination.pages) { %>
                                    <a href="/patient/history?page=<%= pagination.page + 1 %><%= typeof pagination !== 'undefined' && pagination.limit ? '&limit=' + pagination.limit : '' %><%= typeof startDate !== 'undefined' && startDate ? '&startDate=' + encodeURIComponent(startDate) : '' %><%= typeof endDate !== 'undefined' && endDate ? '&endDate=' + encodeURIComponent(endDate) : '' %>" 
                                       style="padding: 8px 16px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 12px; font-weight: 600; text-decoration: none;">
                                        Next Page →
                                    </a>
                                <% } else { %>
                                    <span style="padding: 8px 16px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; color: var(--muted); font-size: 12px; cursor: not-allowed;">
                                        Next Page →
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </section>
        </main>
    </div>
</body>
</html>
