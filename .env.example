# ========================================================
# HEALTH TRACKER BACKEND — ENVIRONMENT TEMPLATE
# Copy to .env and configure with appropriate secrets.
# NEVER commit .env to version control.
# ========================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# Database Connection URI (MongoDB)
# Local: mongodb://127.0.0.1:27017/health_monitoring
# Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/health_monitoring?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/health_monitoring

# JWT Authentication Secrets
# Production MUST be a secure random 32+ character key.
# e.g., generated with: openssl rand -base64 48
JWT_SECRET=your_secure_random_jwt_secret_of_at_least_32_characters_here
JWT_EXPIRES_IN=24h

# Cross-Origin Resource Sharing (CORS)
# Allowed origins for frontend clients (comma-separated if multiple)
# Wildcards ('*') are strictly disallowed in production when credentials/cookies are enabled.
CORS_ORIGIN=http://localhost:5173

# IoT Ingestion Security
# When true, POST /api/iot/data strictly requires Authorization: Bearer <API_KEY>
# Enforced automatically when NODE_ENV=production
REQUIRE_DEVICE_API_KEY=false

# Authentication Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_REGISTER_MAX_ATTEMPTS=10

# IoT Telemetry Ingestion Rate Limiter
IOT_RATE_LIMIT_WINDOW_MS=60000
IOT_RATE_LIMIT_MAX_REQUESTS=120

# Express Trust Proxy (set to 'loopback', 'linklocal', 'uniquelocal', or number of hops behind reverse proxy)
TRUST_PROXY=false
